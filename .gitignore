# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Test, coverage, and type-checking caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Virtual environments
.runtime/
.venv/
venv/
env/

# Packaging artifacts
build/
dist/
*.egg-info/

# Editor and operating-system files
.DS_Store
.idea/
.vscode/

# Local secrets
.env
.env.*
!.env.example

# Local application data
client/data-entry/config.json
client/data-entry/name.csv
client/data-entry/output.txt

# Trained model artifacts
client/data-entry/models/*
!client/data-entry/models/.gitkeep
